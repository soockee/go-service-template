# Copy to .env for local runs. Every setting is read in internal/config.

# Listen address.
ADDR=:8080
# dev or prod. prod requires DATABASE_URL and defaults to JSON logs.
APP_ENV=dev
# debug, info, warn, error
LOG_LEVEL=debug
# text or json (default: text in dev, json in prod)
LOG_FORMAT=text
# Empty = in-memory store. Matches compose.yaml:
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable
# Comma-separated origins allowed to call the API cross-origin. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=
SHUTDOWN_TIMEOUT=10s
